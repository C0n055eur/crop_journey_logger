{
  "version": 1,
  "author": "Prasanna",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled1", "top": -110, "left": 200, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btnPage", "top": 200, "left": -150, "attrs": { "color": "blue", "label": "PAGE" } },
    { "type": "wokwi-led", "id": "ledA", "top": -160, "left": -120, "attrs": { "color": "red", "label": "ALERT" } },
    { "type": "wokwi-resistor", "id": "rA", "top": -100, "left": -120, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "oled1:SCL", "esp:22", "blue", [ "v0" ] ],
    [ "oled1:SDA", "esp:21", "purple", [ "v0" ] ],

    [ "esp:25", "rA:1", "red", [ "v0" ] ],
    [ "rA:2", "ledA:A", "red", [ "v0" ] ],
    [ "ledA:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "btnPage:1.l", "esp:32", "blue", [ "v0" ] ],
    [ "btnPage:2.l", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  },
  "dependencies": {}
}
